# Copia a .env (nunca lo subas a git). En Netlify, define estas variables en Site settings → Environment variables.

# --- Sitio (se usan en el build: canonical, sitemap, Open Graph) ---
SITE_URL=https://tu-dominio.com
SITE_NAME=Utilia

# --- Datos legales (sustituyen los placeholders de /aviso-legal y /privacidad) ---
LEGAL_OWNER=
LEGAL_ID=
LEGAL_ADDRESS=
CONTACT_EMAIL=

# --- Servidor Node (server.js) ---
PORT=8141
NODE_ENV=production
# Carpeta para JSONL locales si no hay Supabase (contacto y analítica)
DATA_DIR=./data
RATE_SALT=cambia-esto-por-una-cadena-aleatoria

# --- Base de datos PostgreSQL (Supabase u otro proveedor con PostgREST). Ver db/schema.sql ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Contacto: aviso opcional a un webhook (Slack, Discord, Make…) ---
CONTACT_WEBHOOK_URL=

# --- Analítica propia (agregada, sin cookies). «off» la desactiva ---
ANALYTICS=on

# --- Publicidad: 1 muestra los espacios reservados. Antes, añade un CMP de cookies ---
ADS_ENABLED=0

# --- IA (tipo C). Solo backend. Con AI_PROVIDER definido en el build se publican las herramientas IA ---
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_HOURLY_LIMIT=10
AI_DAILY_LIMIT=500

# --- Tipos de cambio (conversor de monedas). Por defecto Frankfurter v2 ---
RATES_API=https://api.frankfurter.dev/v2

# --- Herramientas de servidor (tipo B) ---
MAX_UPLOAD_MB=20

# --- Google Analytics 4 (solo tras aceptar el aviso de cookies). off = sin GA ni banner ---
GA_ID=G-CNZEVCVLGJ

